  m_Script: {fileID: 11500000, guid: bb2c269d7935dce458ac0130a2378b91, type: 3}
  m_Name: OpeningStoryData
  m_EditorClassIdentifier: 
  storySegments:
  - bgSprite: {fileID: 21300000, guid: ce2dce216681ae247bc49f18448d876e, type: 3}
    storyText: "\u5636...\u6211\u7684\u5934\u597D\u75DB\u3002\u8FD9\u3002\u3002\u3002\u8FD9\u662F\u54EA\uFF1F"
    textSpeed: 0.1
  - bgSprite: {fileID: 21300000, guid: 4a514a280915db94895c5a882c005ca2, type: 3}
    storyText: "\u8FD9\u662F\u6211\u5417\uFF1F\u6211\u4E3A\u4EC0\u4E48\u662F\u8FD9\u4E2A\u6837\u5B50\u3002\u3002\u3002\u53D1\u751F\u4E86\u4EC0\u4E48\uFF1F\u6211\u600E\u4E48\u4EC0\u4E48\u90FD\u8BB0\u4E0D\u8D77\u6765\u4E86\u3002"
    textSpeed: 0.1
  - bgSprite: {fileID: 21300000, guid: 12c17a05369213c4bb345a28c6cbcbc3, type: 3}
    storyText: "\u65C1\u767D\uFF1A\u7A81\u7136\uFF0C\u6211\u7684\u8111\u5B50\u91CC\u9762\u95EA\u73B0\u662F\u4E00\u4E9B\u753B\u9762"
    textSpeed: 0.1
  - bgSprite: {fileID: 21300000, guid: 6c8813665426cdc4285d5179e1bf832c, type: 3}
    storyText: "\u8FD9\u662F\u56FD\u738B\u5417\uFF1F\u4ED6\u770B\u8D77\u6765\u975E\u5E38\u7684\u82F1\u52C7"
    textSpeed: 0.1
  - bgSprite: {fileID: 21300000, guid: c680c0375bcab7f4c9947fd64d3f9816, type: 3}
    storyText: "\u8FD9\u4E2A\u56FD\u5BB6\u770B\u8D77\u6765\u5F88\u5B89\u5B81\u3002\u6211\u4E5F\u662F\u8FD9\u4E2A\u56FD\u5BB6\u7684\u4E00\u5458\u5417\uFF1F"
    textSpeed: 0.1
  - bgSprite: {fileID: 21300000, guid: 12c17a05369213c4bb345a28c6cbcbc3, type: 3}
    storyText: "\u65C1\u767D\uFF1A\u5E78\u798F\u7684\u56DE\u5FC6\u7A81\u7136\u6D88\u5931\uFF0C\u4E0E\u6B64\u540C\u65F6\u4E00\u4E9B\u4E0E\u4E4B\u524D\u8BB0\u5FC6\u5B8C\u5168\u76F8\u53CD\u7684\u753B\u9762\u6D6E\u73B0\u4E86\u51FA\u6765"
    textSpeed: 0.1
  - bgSprite: {fileID: 21300000, guid: 510415e448e8bc84aa1e8548279815c0, type: 3}
    storyText: "\u8FD9\uFF01\u8FD9\u53D1\u751F\u4E86\u4EC0\u4E48\uFF1F\u4E3A\u4EC0\u4E48\u7A81\u7136\u53D8\u6210\u8FD9\u6837"
    textSpeed: 0.1
  - bgSprite: {fileID: 21300000, guid: 12c17a05369213c4bb345a28c6cbcbc3, type: 3}
    storyText: "\u6B64\u65F6\u4E00\u4E2A\u58F0\u97F3\u5728\u8111\u4E2D\u60F3\u8D77\uFF1A\u949F...\u7075\u9B42...\u4E3A\u4EC0\u4E48\uFF01\uFF08\u8FD9\u4E2A\u58F0\u97F3\u5F88\u719F\u6089\uFF09"
    textSpeed: 0.1
